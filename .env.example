# --- Required in production -------------------------------------------------

# Public URL of the deployment. Also decides whether the session cookie is Secure,
# so set it to your real https origin.
NEXT_PUBLIC_APP_URL=https://pastdue.app

# 32+ random characters. Signs session cookies AND derives the key that encrypts
# each customer's Stripe key at rest. Changing it logs everyone out and makes
# stored Stripe keys unreadable.
APP_SECRET=

# Postgres connection string. If unset, the app falls back to an embedded PGlite
# database in ./.data/pglite — fine for local development, not for production.
DATABASE_URL=

# Shared secret for POST/GET /api/cron. If unset, the endpoint is open in
# development and refuses every request in production.
CRON_SECRET=

# --- Sending customer emails -------------------------------------------------
# Without this, every send is written to an in-memory outbox (visible at
# /api/outbox) and nothing reaches a real customer.
RESEND_API_KEY=
EMAIL_FROM="PastDue <recover@mail.pastdue.app>"

# --- Founder-voice email drafting -------------------------------------------
# Optional. Without it, the built-in templates are used, which are complete and
# safe to send. One call per connection, cached in the database.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Billing (your own subscription revenue) --------------------------------
# Without these, the app runs with everyone on the free plan and the upgrade
# button reports that billing is not configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
